{
  "name": "dsh-wide-focus",
  "version": "0.13.4",
  "description": "DSH 桌面客户端的宽屏阅读模式、可拖动悬浮任务面板，以及上下文管家（占用 / 缓存 / 连贯性 + 交接建议）",
  "license": "MIT",
  "author": "BOB",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/quanwenbo/dsh-wide-focus.git"
  },
  "homepage": "https://github.com/quanwenbo/dsh-wide-focus",
  "bugs": {
    "url": "https://github.com/quanwenbo/dsh-wide-focus/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "wide-mode",
    "task-panel",
    "context-guard"
  ],
  "type": "module",
  "engines": {
    "dsh": ">=0.2.0-rc.1 <0.3.0-0"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE",
    "docs/screenshots/*.png"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "devDependencies": {
    "jsdom": "^30.1.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
